FROM postgres:17
RUN localedef -i de_DE -c -f UTF-8 -A /usr/share/locale/locale.alias de_DE.UTF-8
ENV LANG=de_DE.utf8

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
    postgresql-plperl-17 \
    libmath-spline-perl \
    ; \
    rm -rf /var/lib/apt/lists/*

COPY 01-init-gw-db.sh /docker-entrypoint-initdb.d/01-init-gw-db.sh
RUN chmod 0755 /docker-entrypoint-initdb.d/01-init-gw-db.sh