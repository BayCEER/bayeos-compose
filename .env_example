# Secret environment variables for bayeos-compose.
# Copy this file to .env and edit the values as needed.

POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

QUEST_DB_USER=admin
QUEST_DB_PASSWORD=bayeos

BAYEOS_DB_USER=admin
BAYEOS_DB_PASSWORD=bayeos

GW_DB_USER=admin
GW_DB_PASSWORD=bayeos

WS_API_KEY=sdf890sdf

GW_EXPORT_USER=root
GW_EXPORT_PASSWORD=bayeos

TZ=Europe/Berlin
# For more optional environment variables,
# see the service definitions in docker-compose.yml

# Local paths for volumes (optional, defaults to named volumes).
# GW_DB_DATA=/path/to/gateway-db-data
# GW_UPLOADS_DIR=/path/to/gateway-uploads
# BAYEOS_DB_DATA=/path/to/bayeos-db-data
# QUEST_DB_DATA_DIR=/path/to/quest-db-data

# Image overrides (optional, defaults to the latest published image).
# BAYEOS_API_IMAGE=bayceer/bayeos-api:latest
# BAYEOS_GATEWAY_IMAGE=bayceer/bayeos-gateway:latest

